<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Polka.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#1B1915"/>
      <Setter Property="Foreground" Value="#F3ECDF"/>
      <Setter Property="BorderBrush" Value="#3A342A"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="8,6"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Background" Value="#E0A15A"/>
      <Setter Property="Foreground" Value="#1A1208"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#E0A15A"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#B3A894"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Foreground" Value="#F3ECDF"/>
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#24211B"/>
      <Setter Property="Foreground" Value="#F3ECDF"/>
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#F3ECDF"/>
      <Setter Property="BorderBrush" Value="#3A342A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Margin" Value="0,0,4,4"/>
    </Style>
    <Style Selector="Button.chip.active">
      <Setter Property="Background" Value="#E0A15A"/>
      <Setter Property="Foreground" Value="#1A1208"/>
      <Setter Property="BorderBrush" Value="#E0A15A"/>
    </Style>
    <Style Selector="ListBox.archive">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ListBox.archive ListBoxItem">
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style Selector="ListBox.archive ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#24211B"/>
    </Style>
    <Style Selector="TextBlock.kicker">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#B3A894"/>
      <Setter Property="LetterSpacing" Value="1.4"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#B3A894"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#E38B78"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Application.Styles>
</Application>
